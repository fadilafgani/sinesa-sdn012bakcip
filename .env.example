# ==========================================
# KONFIGURASI DATABASE MYSQL (cPanel Production)
# ==========================================
DB_HOST=localhost
DB_PORT=3306

# Ganti dengan nama database lengkap di cPanel
# Contoh: cpaneluser_sinesadb
DB_NAME=cpaneluser_sinesadb

# Ganti dengan username MySQL di cPanel
# Contoh: cpaneluser_dbuser
DB_USER=cpaneluser_dbuser

# Password user database MySQL di cPanel
DB_PASS=password_database_anda

DB_CHARSET=utf8mb4

